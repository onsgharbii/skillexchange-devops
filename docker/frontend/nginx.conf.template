# Rendered at container start: ${BACKEND_URL} comes from the environment.
server {
    listen 8080;
    root /usr/share/nginx/html;
    client_max_body_size 10m;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # API calls go to the Spring Boot backend (same origin, so no CORS needed)
    location /skillExchange/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Angular routes are handled client-side
    location / {
        try_files $uri $uri/ /index.html;
    }
}
